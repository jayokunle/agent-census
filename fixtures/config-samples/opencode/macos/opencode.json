{
  "$schema": "https://opencode.ai/config.json",
  // Non-MCP settings the adapter must leave alone.
  "model": "anthropic/claude-sonnet-5-5",
  "mcp": {
    "timeout": { "startup": 30000 },
    "servers": {
      "filesystem-spike": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/tmp/mcp-enterprise-spike"],
        "environment": {},
      },
      "org-proxy-example": {
        "type": "remote",
        "url": "https://mcp.example.com/org/acme/filesystem-spike",
        "headers": { "Authorization": "Bearer {env:MCP_ENTERPRISE_TOKEN}" },
        "oauth": false,
      },
    },
  },
}
